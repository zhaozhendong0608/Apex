    yy = top + 0.06 + (i // 2) * 2.28
    rect(s, xx, yy, W2, 2.02, fill=CARD, line=LINE, line_w=0.75, radius=0.03)
    text(s, xx + 0.30, yy + 0.22, 0.4, 0.4, [dict(t="“", size=26, bold=True, color=ACCENT)], check=False)
    text(s, xx + 0.66, yy + 0.26, W2 - 1.0, 0.86, [dict(t=q, size=14, bold=True, color=INK, line=1.5)],
         check=True, tag=f"q{i}")
    line_shape(s, xx + 0.66, yy + 1.24, xx + W2 - 0.34, yy + 1.24, LINE, 0.75)
    text(s, xx + 0.66, yy + 1.38, W2 - 1.0, 0.5, [dict(t=why, size=10, color=MUTED, line=1.4)],
         check=True, tag=f"why{i}")
footer(s, 16, TOTAL)
notes(s, "4 分钟。四句话让非开发同事也能立刻用起来 —— 他们不需要懂 Maven，也能听懂「证据是什么」。\n"
         "建议现场让大家把第一句抄进自己的便签。")

# ============================================================ 17 什么时候别用
s = blank(prs)
top = header(s, "17", "诚实 · 边界", "有些时候，别用这套流程",
             sub="把流程当信仰，和不用流程一样危险。判断标准只有一条：流程成本 vs 返工成本。")

cases = [("一次性脚本", "跑完就扔，没有下一个人维护"),
         ("还在探索的原型", "需求自己都还没想清，先让它跑起来看"),
         ("纯样式微调", "一个 CSS 值，走一遍流程纯属自虐"),
         ("只为演示的 demo", "明天就要演，先出效果，回头再补")]
for i, (a, b) in enumerate(cases):
    xx = ML + (i % 2) * (W2 + 0.32)
    yy = top + 0.06 + (i // 2) * 1.44
    rect(s, xx, yy, W2, 1.20, fill=PAPER, radius=0.04)
    text(s, xx + 0.30, yy + 0.20, 5.0, 0.3, [dict(t=a, size=13.5, bold=True, color=INK)], check=False)
    text(s, xx + 0.30, yy + 0.58, 5.0, 0.3, [dict(t=b, size=10.5, color=MUTED)], check=False)

rect(s, ML, 5.36, CW, 0.96, fill=TEAL_L, radius=0.04)
text(s, ML + 0.30, 5.50, CW - 0.6, 0.68, [
    dict(t="流程的目的是减少返工，不是增加仪式。当流程成本 > 返工成本，就用 B2，或者干脆别用。",
         size=12.5, bold=True, color=TEAL, line=1.45)], check=True, tag="bound")
footer(s, 17, TOTAL)
notes(s, "3 分钟。这页是可信度的来源 —— 讲清「什么时候不用」，前面的「什么时候用」才有人信。\n"
         "可以自嘲一句：我自己写一次性脚本，也从来不跑流程。")

# ============================================================ 18 90 天
s = blank(prs)
top = header(s, "18", "落地 · 别一次全上", "四周，从一条旁路开始",
             sub="一次性推全流程 = 一次性劝退。按周加码，每周只多学一个动作。")

weeks = [("第 1 周", "只用 B2 和 B3", ["零学习成本，今天就能用", "小改直接说 B2", "报错贴完整栈给 B3"]),
         ("第 2~3 周", "一个真实小需求走 1→3→4→7", ["跳过 2 和 6，先跑通闭环", "重点是看见 [LGTM]", "卡住就停下来问，别硬走"]),
         ("第 2 月", "加 [2] 契约冻结 + [6] 集成", ["接口先定死再写代码", "集成跑真实数据，不用 mock"]),
         ("第 3 月", "老项目 B1 + 复盘卡", ["先建地图再动刀", "踩过的坑写成 postmortem"])]
for i, (wk, ttl, points) in enumerate(weeks):
    xx = ML + i * 2.98
    rect(s, xx, top + 0.30, 2.76, 0.04, fill=ACCENT)
    text(s, xx, top + 0.02, 2.7, 0.26, [dict(t=wk, size=10, bold=True, color=ACCENT, font=MONO)], check=False)
    text(s, xx, top + 0.50, 2.7, 0.66, [dict(t=ttl, size=12.5, bold=True, color=INK, line=1.4)],
         check=True, tag=f"wk{i}")
    for j, pt in enumerate(points):
        text(s, xx, top + 1.28 + j * 0.52, 2.66, 0.5, [dict(t="· " + pt, size=9.5, color=INK_SOFT, line=1.35)],
             check=True, tag=f"wkp{i}{j}")

rect(s, ML, 5.94, CW, 0.88, fill=CARD, line=LINE, line_w=0.75, radius=0.04)
text(s, ML + 0.30, 6.04, CW - 0.6, 0.3, [dict(t="配套材料", size=9.5, bold=True, color=MUTED, font=MONO)], check=False)
text(s, ML + 0.30, 6.32, CW - 0.6, 0.34, [
    dict(t="README（总览） · BEGINNER_HANDBOOK（保姆级） · docs/playbooks/demo-scripts.md（照着念的剧本） · workflow_guide.html（可交互）",
         size=10.2, color=INK_SOFT)], check=False)
footer(s, 18, TOTAL)
notes(s, "5 分钟。落地页要具体到「下周做什么」，不要停在「大家要重视」。\n"
         "建议指定一个人当「工作流值班人」，第一周专门解答 B2/B3 的用法。")

# ============================================================ 19 速查卡
s = blank(prs)
top = header(s, "19", "带走 · 一页纸", "贴显示器边上")

quad = [
    ("日常三连", ["开工   B6", "干活   3 / B3 / B2", "收工   B5"], TEAL),
    ("主链", ["1 规划 → 2 方案 → 3 编码", "4 门禁 → 5 评审 → 6 集成", "7 验收（唯一标绿出口）"], TEAL),
    ("三条硬命令", ["board.py list", "board.py verify \"Task-XXX\"", "board.py complete ... --accept"], INK),
    ("五个不许", ["不改 status.md", "不跳过 verify", "不写死假数据", "不私装依赖", "不改字段不改文档"], ACCENT),
]
for i, (ttl, lines, color) in enumerate(quad):
    xx = ML + (i % 2) * (W2 + 0.32)
    yy = top + 0.02 + (i // 2) * 2.28
    rect(s, xx, yy, W2, 2.06, fill=CARD, line=LINE, line_w=0.75, radius=0.03)
    rect(s, xx, yy, 0.05, 2.06, fill=color)
    text(s, xx + 0.30, yy + 0.18, 4.8, 0.3, [dict(t=ttl, size=11, bold=True, color=color, font=MONO)], check=False)
    for j, ln in enumerate(lines):
        text(s, xx + 0.30, yy + 0.58 + j * 0.44, 4.9, 0.36,
             [dict(t=ln, size=10.5, color=INK, font=MONO if i != 0 else FONT, line=1.3)], check=False)
footer(s, 19, TOTAL)
notes(s, "2 分钟。这一页可以单独导成 A4 打印，或截图发群里。\n"
         "建议做成 PDF 贴在工位，比记 13 个指令靠谱。")

# ============================================================ 20 结束
s = blank(prs, DARK)
text(s, ML, 1.10, 7.4, 0.34, [dict(t="接下来 24 小时", size=10, color=RGBColor(0x8C, 0x91, 0x96), font=MONO)], check=False)
text(s, ML, 1.52, 7.6, 1.2, [dict(t="今天只做一件事：", size=30, bold=True, color=PAPER, line=1.4),
                             dict(t="先把它当包工头，而不是许愿池。", size=30, bold=True, color=ACCENT, line=1.4)],
     check=False)

acts = [("01", "明天开工第一句，发 B6", "看它能不能 3 秒把你昨天的现场接上"),
        ("02", "找一个 ≤ 20 行的改动，用 B2 走一遍", "感受一下「改完就完」是什么效率"),
        ("03", "下次 AI 说「做完了」，问它证据", "文件清单 / 门禁结果 / verify 凭证")]
for i, (num, a, b) in enumerate(acts):
    yy = 3.28 + i * 0.94
    text(s, ML, yy + 0.04, 0.5, 0.3, [dict(t=num, size=10, bold=True, color=ACCENT, font=MONO)], check=False)
    text(s, ML + 0.58, yy, 7.2, 0.32, [dict(t=a, size=14, bold=True, color=PAPER)], check=False)
    text(s, ML + 0.58, yy + 0.34, 7.2, 0.3, [dict(t=b, size=10, color=RGBColor(0x9A, 0x9E, 0xA2))], check=False)

# 右侧资源
rx = 8.55
rect(s, rx, 1.62, 4.0, 4.24, fill=DARK_2, radius=0.03)
text(s, rx + 0.32, 1.84, 3.4, 0.3, [dict(t="有问题先看这四个", size=11, bold=True, color=PAPER)], check=False)
res = ["README.md", "BEGINNER_HANDBOOK.md", "docs/playbooks/demo-scripts.md", "workflow_guide.html"]
for i, r in enumerate(res):
    text(s, rx + 0.32, 2.34 + i * 0.62, 3.4, 0.3, [dict(t=r, size=9.5, color=RGBColor(0xC9, 0xC5, 0xBA), font=MONO)],
         check=False)
    if i < 3:
        line_shape(s, rx + 0.32, 2.74 + i * 0.62, rx + 3.68, 2.74 + i * 0.62, RGBColor(0x33, 0x39, 0x3C), 0.75)
text(s, rx + 0.32, 4.92, 3.4, 0.6, [dict(t="16 篇 SOP 在 .ai/sop/", size=9.5, color=RGBColor(0x8C, 0x91, 0x96), line=1.5)],
     check=False)

text(s, ML, 6.34, 7.6, 0.3, [dict(t="谢谢 · 现在可以开始问「我们组怎么用」了", size=11,
                                 color=RGBColor(0x8C, 0x91, 0x96))], check=False)
footer(s, 20, TOTAL, dark=True)
notes(s, "最后 5 分钟留给提问。三个动作任选一个承诺即可，不要要求全做。\n"
         "如果时间不够，直接跳过 18/19 两页，把速查卡发群里。")

prs.save(OUT)

warn = L.report_warnings()
print(f"saved: {OUT}")
print(f"slides: {len(prs.slides.__iter__.__self__._sldIdLst)}")
if warn:
    print("\n".join(warn))
else:
    print("no overflow warnings")
