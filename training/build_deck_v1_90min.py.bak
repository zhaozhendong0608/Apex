# ============================================================ 15 五个不许
s = blank(prs, DARK)
top = header(s, "15", "红线 · 五条", "这五件事，做了等于没走流程", dark=True)

forbids = [
    ("01", "不许手改状态看板", "锚点一坏，后面的 verify / complete 全部失效，还查不出原因"),
    ("02", "不许跳过 verify 直接 complete", "脚本会拒绝；你硬绕，等于用人的信任补机器的证据"),
    ("03", "不许用假数据让页面「看起来能跑」", "这是唯一零容忍的一条，会把联调问题推迟到上线"),
    ("04", "不许私自装新依赖", "要装可以，但由人拍板：版本、离线、体积，都是人的责任"),
    ("05", "不许改了字段不更新设计文档", "下次 AI 照旧文档写代码，你和它就会打架"),
]
for i, (num, ttl, why) in enumerate(forbids):
    yy = top + 0.10 + i * 0.92
    if i:
        line_shape(s, ML, yy - 0.12, MR, yy - 0.12, RGBColor(0x2E, 0x34, 0x37), 0.75)
    text(s, ML, yy + 0.02, 0.5, 0.3, [dict(t=num, size=10, bold=True, color=ACCENT, font=MONO)], check=False)
    text(s, ML + 0.60, yy - 0.04, 6.6, 0.36, [dict(t=ttl, size=15.5, bold=True, color=PAPER)], check=False)
    text(s, 7.95, yy + 0.02, 4.6, 0.5, [dict(t=why, size=9.8, color=RGBColor(0x9A, 0x9E, 0xA2), line=1.4)],
         check=True, tag=f"forbid{i}")
footer(s, 15, TOTAL, dark=True)
notes(s, "4 分钟。大字念完即可，不要解释太多 —— 红线的作用是被记住，不是被理解。\n"
         "可以打印成 A4 贴在每个工位。")

# ============================================================ 16 四句话
s = blank(prs)
top = header(s, "16", "技巧 · 把「帮我写」换掉", "四句话，能省掉一半返工")

quotes = [
    ("「先别写代码，把方案和影响面说清楚。」", "省一次返工：先对齐再动手，比写完再改便宜十倍"),
    ("「只改这个文件，其他一律不动。」", "防顺手重构：改动面越小，review 越快，出错越少"),
    ("「根因是什么？用白话讲，再给最小修法。」", "防瞎试：讲不清根因，说明它只是在猜"),
    ("「你说做完了 —— 证据是什么？」", "防自我认证：文件、门禁、verify，三样都要有"),
]
for i, (q, why) in enumerate(quotes):
